# =============================================================================
# Copy to .env — docs/SETUP.md (runtime) · docs/CONFIG.md (all variables)
# =============================================================================

# --- Chat: Qwen2.5-3B on llama.cpp :8000 (see docs/CHAT_MODEL.md) ---
CHAT_BASE_URL=http://localhost:8000/v1
CHAT_MODEL=qwen2.5-3b-instruct-q5_k_m.gguf
CHAT_TEMPERATURE=0.2
CHAT_TEMPERATURE_ROUTING=0.2
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_HISTORY_MAX_MESSAGES_ROUTING=6
CHAT_CONTEXT_MAX_TOKENS=1700
CHAT_CONTEXT_MAX_TOKENS_ROUTING=1500
CHAT_MESSAGE_MAX_CHARS=1200
CHAT_MESSAGE_MAX_CHARS_ROUTING=450
CHAT_CHROMA_MAX_CHARS=1400
CHAT_CHROMA_MAX_CHARS_ROUTING=500
CHAT_SUMMARY_LLM_ENABLED=true
CHAT_SUMMARY_MAX_MESSAGES=8
CHAT_RAW_LOG_MAX_MESSAGES=40
ORCHESTRATOR_MAX_ROUNDS=3
CHAT_TOP_P=0.9
CHAT_TOP_K=40
CHAT_STREAM=true
CHAT_LOGPROBS=5

# --- Intent / topic (uses sentence-transformers when embed backend is ST or http+sync) ---
INTENT_SEMANTIC_ENABLED=true
INTENT_SEMANTIC_MIN_SCORE=0.42
INTENT_SEMANTIC_MARGIN=0.06
TOPIC_SHIFT_MAX_SIMILARITY=0.52
TOPIC_HISTORY_MIN_SIMILARITY=0.40
CONVERSATIONAL_MIN_SCORE=0.38
CONVERSATIONAL_VS_OPS_MARGIN=0.04

# --- RAG embeddings (pick ONE backend — see docs/SETUP.md) ---
RAG_EMBEDDING_BACKEND=http
EMBED_BASE_URL=http://localhost:8081/v1
EMBED_SERVER_PORT=8081
SENTENCE_TRANSFORMERS_MODEL=BAAI/bge-small-en-v1.5
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_EXPECTED_DIMENSION=384
# In-process (no :8081): RAG_EMBEDDING_BACKEND=sentence-transformers
# GGUF embed on :8081: RAG_EMBEDDING_BACKEND=llama + ./scripts/run-llama-embed-server.sh
# LOCAL_MODELS_ROOT=/path/to/models
# python scripts/download_embedding_model.py

# --- Chroma (docker compose) ---
RAG_VECTOR_STORE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_HNSW_SPACE=cosine
CHROMA_COLLECTION=apex_kb
CHROMA_SESSION_COLLECTION=apex_session_intents
CHROMA_STATE_COLLECTION=apex_graph_state
CHROMA_AGENT_ROLES_COLLECTION=apex_agent_roles
CHROMA_INTENT_ROUTES_COLLECTION=apex_intent_routes
CHROMA_INTENT_ROUTE_TOP_K=3
CHROMA_INTENT_ROUTE_MIN_SCORE=0.72
CHROMA_SYSTEM_ENRICH_TOP_K=3
SESSION_MEMORY_ENABLED=true
SESSION_MEMORY_TOP_K=3
SESSION_MEMORY_REUSE_MAX_DISTANCE=0.55
RAG_KEYWORD_FALLBACK=true
RAG_RETRIEVE_K=10
RAG_TOP_K=2
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# --- Neo4j knowledge graph (optional — docs/KG_NEO4J.md) ---
KG_NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
KG_ONTOLOGY_PATH=data/kg/ontology/ticketing_apex.json
KG_GLINER_MODEL=urchade/gliner_medium-v2.1
KG_GLINER_ENABLED=true
KG_GLINER_THRESHOLD=0.45
KG_ENRICH_MAX_HITS=8

# --- LangGraph + plugins ---
LANGGRAPH_RUNTIME_ENABLED=true
LANGGRAPH_CHECKPOINT_PATH=data/langgraph/checkpoints.sqlite
LANGGRAPH_STORE_PATH=data/langgraph/store.sqlite
DYNAMIC_TOOLS_ENABLED=true
PLUGIN_ALLOWED_HOST_SUFFIXES=api.apex-dev.axsdevops.io,localhost,127.0.0.1
PLUGIN_HTTP_TIMEOUT_SEC=30
PLUGIN_SCRIPT_ENABLED=true
PLUGIN_SCRIPT_MAX_BYTES=16384
PLUGIN_SCRIPT_TIMEOUT_SEC=5
PLUGIN_SANDBOX_BACKEND=auto
PLUGIN_DOCKER_IMAGE=ticketing-ai-demo-plugin-worker:local

# --- Docker sandbox toolkit (Python + React jobs — docs/SANDBOX_TOOLKIT.md) ---
SANDBOX_TOOLKIT_ENABLED=true
SANDBOX_TOOLKIT_IMAGE=ticketing-ai-demo-sandbox-toolkit:local
SANDBOX_TOOLKIT_TIMEOUT_SEC=120
SANDBOX_PIP_ALLOWLIST=pandas,numpy,matplotlib,httpx,pillow
SANDBOX_NPM_ALLOWLIST=react,react-dom,recharts
SANDBOX_MAX_SOURCE_BYTES=65536
PLUGIN_DOCKER_IMAGE=ticketing-ai-demo-plugin-worker:local

# --- apex-dev APIs (docs/API_LINKS.md) ---
APEX_SEARCH_BASE_URL=https://api.apex-dev.axsdevops.io/search
APEX_SEARCH_SWAGGER_URL=https://api.apex-dev.axsdevops.io/search/swagger/v1/swagger.json
APEX_ADMIN_BASE_URL=https://api.apex-dev.axsdevops.io/admin
APEX_ADMIN_SWAGGER_URL=https://api.apex-dev.axsdevops.io/admin/swagger/v1/swagger.json
APEX_RESOURCES_BASE_URL=https://api.apex-dev.axsdevops.io/resources
APEX_RESOURCES_SWAGGER_URL=https://api.apex-dev.axsdevops.io/resources/swagger/v1/swagger.json
RESOURCES_CLIENT_ID=11
RESOURCES_AXS_CLIENT_ID=4
RESOURCES_USERS_PAGE_SIZE=50
APEX_EVENTS_BASE_URL=https://api.apex-dev.axsdevops.io/events
APEX_EVENTS_SWAGGER_URL=https://api.apex-dev.axsdevops.io/events/swagger/v1/swagger.json
APEX_INVENTORY_BASE_URL=https://api.apex-dev.axsdevops.io/inventory
APEX_INVENTORY_SWAGGER_URL=https://api.apex-dev.axsdevops.io/inventory/swagger/v1/swagger.json
APEX_MANIFEST_BASE_URL=https://api.apex-dev.axsdevops.io/manifest
APEX_MANIFEST_SWAGGER_URL=https://api.apex-dev.axsdevops.io/manifest/swagger/v1/swagger.json
APEX_REPORTS_BASE_URL=https://api.apex-dev.axsdevops.io/reports
APEX_REPORTS_SWAGGER_URL=https://api.apex-dev.axsdevops.io/reports/swagger/v1/swagger.json
REPORTS_DEFAULT_REGION_ID=1
APEX_MARKETING_BASE_URL=https://api.apex-dev.axsdevops.io/marketing
APEX_MARKETING_SWAGGER_URL=https://api.apex-dev.axsdevops.io/marketing/swagger/v1/swagger.json
MARKETING_FALLBACK_SEARCH_QUERY=event
MARKETING_LIST_PAGE_SIZE=25

APEX_BEARER_TOKEN=
APEX_MOCK=false
DEMO_CLIENT_ID=
DEMO_MUTATIONS_DRY_RUN=false
