# Local llama.cpp OpenAI-compatible chat server (intent / planning)
CHAT_BASE_URL=http://localhost:8000/v1
CHAT_MODEL=qwen2.5-0.5b-instruct-q4_k_m.gguf

# RAG embeddings — HTTP server on port 8081 (default)
# Terminal: ./scripts/run-embed-server.sh
RAG_EMBEDDING_BACKEND=http
EMBED_BASE_URL=http://localhost:8081/v1
EMBED_SERVER_PORT=8081
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# In-process (no :8081 server): RAG_EMBEDDING_BACKEND=sentence-transformers
# llama.cpp GGUF embed on :8081: ./scripts/run-llama-embed-server.sh + RAG_EMBEDDING_BACKEND=llama

# Vector store (Chroma in Docker — see docker-compose.yml)
RAG_VECTOR_STORE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_COLLECTION=apex_kb

# Legacy numpy cache: RAG_VECTOR_STORE=numpy
# If Chroma/embeddings fail, match KB by keywords (demo only)
RAG_KEYWORD_FALLBACK=true
RAG_TOP_K=2

# apex-dev gateway — see docs/API_LINKS.md for all swagger URLs
APEX_SEARCH_BASE_URL=https://api.apex-dev.axsdevops.io/search
APEX_SEARCH_SWAGGER_URL=https://api.apex-dev.axsdevops.io/search/swagger/v1/swagger.json
APEX_ADMIN_BASE_URL=https://api.apex-dev.axsdevops.io/admin
APEX_ADMIN_SWAGGER_URL=https://api.apex-dev.axsdevops.io/admin/swagger/v1/swagger.json
# Local .NET: APEX_SEARCH_BASE_URL=http://localhost:5005  APEX_ADMIN_BASE_URL=http://localhost:5000
APEX_EVENTS_BASE_URL=https://api.apex-dev.axsdevops.io/events
APEX_EVENTS_SWAGGER_URL=https://api.apex-dev.axsdevops.io/events/swagger/v1/swagger.json
APEX_INVENTORY_BASE_URL=https://api.apex-dev.axsdevops.io/inventory
APEX_INVENTORY_SWAGGER_URL=https://api.apex-dev.axsdevops.io/inventory/swagger/v1/swagger.json
APEX_MARKETING_BASE_URL=https://api.apex-dev.axsdevops.io/marketing
APEX_MARKETING_SWAGGER_URL=https://api.apex-dev.axsdevops.io/marketing/swagger/v1/swagger.json
# JWT from apex-dev login: Authorization Bearer <token>
APEX_BEARER_TOKEN=
APEX_MOCK=false

# Client uuid for "create client venue" when not in the user message
DEMO_CLIENT_ID=
# Set true (or use --execute) to actually POST creates to admin API
DEMO_EXECUTE_WRITES=false
